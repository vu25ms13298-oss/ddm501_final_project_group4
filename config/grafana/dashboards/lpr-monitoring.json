{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "API Requests per Second",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "targets": [
        {
          "expr": "rate(api_requests_total[1m])",
          "legendFormat": "{{method}} {{endpoint}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "title": "Prediction Latency (p50, p95, p99)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(model_prediction_latency_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(model_prediction_latency_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(model_prediction_latency_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "title": "Total Predictions by Plate Type",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "targets": [
        {
          "expr": "model_predictions_total",
          "legendFormat": "{{plate_type}}"
        }
      ]
    },
    {
      "title": "Prediction Errors",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "targets": [
        {
          "expr": "rate(model_prediction_errors_total[5m])",
          "legendFormat": "{{error_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "errors/s"
        },
        "overrides": []
      }
    },
    {
      "title": "Detection Confidence Distribution",
      "type": "histogram",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "targets": [
        {
          "expr": "detection_confidence_bucket",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "title": "Characters Detected per Plate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(plate_char_count_bucket[5m]))",
          "legendFormat": "median chars"
        },
        {
          "expr": "histogram_quantile(0.95, rate(plate_char_count_bucket[5m]))",
          "legendFormat": "p95 chars"
        }
      ]
    },
    {
      "title": "API Uptime",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "targets": [
        {
          "expr": "up{job=\"lpr-api\"}",
          "legendFormat": "API Status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "title": "Model Info",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "targets": [
        {
          "expr": "model_info",
          "legendFormat": "{{model_name}} ({{feature_method}} + {{classifier}})"
        }
      ]
    },
    {
      "title": "Request Latency Heatmap",
      "type": "heatmap",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "targets": [
        {
          "expr": "rate(api_request_latency_seconds_bucket[5m])",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Data & Prediction Drift",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Recognition Success Rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-datasource"
          },
          "expr": "sum(rate(plate_recognition_result_total{result=\"success\"}[15m])) / sum(rate(plate_recognition_result_total[15m]))",
          "legendFormat": "success rate",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Input Brightness (1h vs 7d baseline)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-datasource"
          },
          "expr": "rate(input_image_brightness_sum[1h]) / rate(input_image_brightness_count[1h])",
          "legendFormat": "mean 1h",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-datasource"
          },
          "expr": "rate(input_image_brightness_sum[7d]) / rate(input_image_brightness_count[7d])",
          "legendFormat": "baseline 7d",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Input Width (1h vs 7d baseline)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "px"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-datasource"
          },
          "expr": "rate(input_image_width_pixels_sum[1h]) / rate(input_image_width_pixels_count[1h])",
          "legendFormat": "mean 1h",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-datasource"
          },
          "expr": "rate(input_image_width_pixels_sum[7d]) / rate(input_image_width_pixels_count[7d])",
          "legendFormat": "baseline 7d",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "Live Simulation (fast windows)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Input Brightness (5m vs 1h)",
      "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 41 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "rate(input_image_brightness_sum[5m]) / rate(input_image_brightness_count[5m])",
          "legendFormat": "mean 5m",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "rate(input_image_brightness_sum[1h]) / rate(input_image_brightness_count[1h])",
          "legendFormat": "baseline 1h",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Input Width (5m vs 1h)",
      "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 41 },
      "fieldConfig": { "defaults": { "unit": "px" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "rate(input_image_width_pixels_sum[5m]) / rate(input_image_width_pixels_count[5m])",
          "legendFormat": "mean 5m",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "rate(input_image_width_pixels_sum[1h]) / rate(input_image_width_pixels_count[1h])",
          "legendFormat": "baseline 1h",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Recognition Success Rate (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 41 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "sum(rate(plate_recognition_result_total{result=\"success\"}[5m])) / sum(rate(plate_recognition_result_total[5m]))",
          "legendFormat": "success rate 5m",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "/predict HTTP Status Codes",
      "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 49 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "sum by (status) (rate(api_requests_total{endpoint=~\"/predict.*\"}[1m]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Rate-limited Requests (15m)",
      "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 49 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-datasource" },
          "expr": "sum(increase(model_prediction_errors_total{error_type=\"rate_limit_exceeded\"}[15m])) or vector(0)",
          "legendFormat": "429s",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "lpr",
    "ml-monitoring"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "LPR System Monitoring",
  "uid": "lpr-monitoring",
  "version": 1
}
