# ===========================================
# LPR System Environment Configuration
# ===========================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
# docker compose reads .env automatically.

# ---- API Configuration ----
# mlflow = load models:/lpr-ocr-classifier@production from the MLflow registry
#          (falls back to the baked-in models/ocr_hog_svm if none is promoted)
# local  = always use baked-in models/ocr_hog_svm
MODEL_SOURCE=mlflow
MODEL_URI=models:/lpr-ocr-classifier@production
MODELS_DIR=/app/models/ocr_hog_svm
YOLO_MODEL_PATH=
API_PORT=8000
MAX_UPLOAD_MB=10
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000

# ---- Security & Hot Reload ----
# Shared secret for POST /model/reload (header: X-Admin-Token).
# Required so Airflow can trigger hot reload on API after retraining.
API_ADMIN_TOKEN=lpr-secret-admin-token-2026

# ---- Traffic & Rate Limiting ----
# Max /predict requests per client IP per minute (HTTP 429 above this).
# Set 60 to demo rate limiting (Scenario 6); raise (e.g. 600) for long stress runs.
RATE_LIMIT_PER_MINUTE=60

# ---- MLflow Configuration ----
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_PORT=5000

# ---- PostgreSQL (MLflow & Airflow backend) ----
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow

# ---- MinIO (S3-compatible MLflow artifact store) ----
# Console: http://localhost:9001
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# ---- Airflow Orchestration ----
AIRFLOW_SECRET_KEY=lpr-airflow-secret-key
# Cron schedule of the lpr_monitoring_pipeline DAG (every 15 minutes)
MONITORING_SCHEDULE=*/15 * * * *
# true = monitoring DAG automatically triggers lpr_training_pipeline when drift is detected
AUTO_RETRAIN_ON_DRIFT=false

# ---- Observability (Prometheus & Grafana) ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION=30d
